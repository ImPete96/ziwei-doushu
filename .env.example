# Sao chép thành .env.local rồi điền giá trị thật (.env.local không bị đưa lên Git)

# ─── Luận giải AI (/api/interpret) bằng Claude ───
# Chỉ xem lá số thì không cần điền. Lấy key tại https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key
# Mô hình (mặc định claude-opus-5-5) và mức suy nghĩ: low | medium | high | xhigh | max (mặc định medium)
# ANTHROPIC_MODEL=claude-opus-5-5
# AI_EFFORT=medium

# ─── Hoặc: model chạy trên máy qua Ollama (miễn phí, không cần key, chậm hơn) ───
# Cài Ollama (ollama.com), tải model: ollama pull gemma3:12b
# AI_PROVIDER=ollama
# OLLAMA_MODEL=gemma3:12b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_NUM_CTX=16384

# ─── Hoặc: model chạy trên máy qua LM Studio ───
# Bật máy chủ và nạp model với ngữ cảnh đủ dài:
#   lms server start
#   lms load qwen/qwen3.5-9b -c 16384
# AI_PROVIDER=lmstudio
# LMSTUDIO_MODEL=qwen/qwen3.5-9b
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# 'none' tắt phần suy nghĩ của model (Qwen3.5…); để trống nếu model không nhận tham số này
# LMSTUDIO_REASONING_EFFORT=none

# Giới hạn lượt gọi để tránh tốn phí khi đưa web lên mạng
# AI_RATE_PER_HOUR=30
# AI_DAILY_LIMIT=500

# ─── Trang web ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
